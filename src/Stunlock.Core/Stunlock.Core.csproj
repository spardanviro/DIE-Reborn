<Project Sdk="Microsoft.NET.Sdk">

  <!--
    StunCore.dll 的反编译源码 (未混淆, 纯 BCL, 无 Unity 依赖)。
    提供: StunMessage 编解码器 / StunTCP 分帧与 TCPServer / RequestResult /
          IResponseHandler / Request<T> / ip.cfg 解析。

    源文件不在本目录下 —— 直接 glob 引用外部反编译树, 这样
    重新反编译即自动生效, 且从物理上杜绝"手改生成代码"。
  -->
  <PropertyGroup>
    <RootNamespace>StunCore</RootNamespace>
    <!-- 反编译产物噪音很大, 全局压掉 -->
    <NoWarn>$(NoWarn);CS0108;CS0114;CS0169;CS0219;CS0414;CS0618;CS0649;CS1591;CS0162;CS0067;CS0660;CS0661;SYSLIB0011;SYSLIB0003;CA1416;CA2259;CS0693;CS3021;CS0659;CS9113</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="$(StunCoreSrc)**\*.cs" LinkBase="Generated" />
    <!-- 反编译器生成的 AssemblyInfo 会和 SDK 自动生成的冲突 -->
    <Compile Remove="$(StunCoreSrc)Properties\**\*.cs" />

    <!--
      StunCore.Concurrency.SpinWait 是 net35 时代对 System.Threading.SpinWait 的 backport
      (当年 BCL 还没有这个类型)。在 net9 上两者同时可见, 导致 StunLog / TCPClient /
      DoublyLinkedListNode 三个文件出现 CS0104 歧义。
      已核对: 他们的公开 API (Count / NextSpinWillYield / SpinOnce / Reset / SpinUntil x3)
      是 BCL 版本的真子集, 且全代码库无任何完全限定引用。故直接删除 backport,
      让所有调用点解析到 BCL 原版 —— 比逐文件加别名干净, 语义等价。
    -->
    <Compile Remove="$(StunCoreSrc)StunCore.Concurrency\SpinWait.cs" />

    <!-- 以下由 _Fixups\ 下的同名副本取代, 原因见各文件顶部注释 -->
    <Compile Remove="$(StunCoreSrc)StunCore\StunLog.cs" />
    <Compile Remove="$(StunCoreSrc)DoublyLinkedList.cs" />
  </ItemGroup>

</Project>
