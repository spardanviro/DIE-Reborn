<Project Sdk="Microsoft.NET.Sdk">

  <!--
    游戏自带的那份 Lidgren.Network, 取自 GAME 树。

    ## 为什么不用 NuGet 上的 Lidgren.Network

    Lidgren 的线协议在不同版本之间并不保证兼容 (握手字段、消息头位宽、
    序列号窗口都改过)。这游戏是 2014-2015 年的构建, NuGet 上的版本对不对得上
    只能靠试, 而握手失败的表现是"静默丢包 + 客户端超时", 最难诊断的一类。
    直接编译它自己那份, 逐位一致, 这个变量就不存在了。

    ## 服务端侧的代码在不在

    在。客户端只发布了 NetClient (-iae\-lce.cs : -gce.cs), 没有 NetServer,
    但 NetServer 本来就只是 NetPeer 的薄壳 —— 真正的受理逻辑在 NetPeer 里:

      -iae\-gce.cs:916   case NetMessageType.Connect:      连接受理 + "Server full" 限流
      -iae\-gce.cs:928   NetConnectionStatus.ReceivedInitiation
      -iae\-gce.cs:936   AcceptConnection

    所以我们只要自己写那层薄壳 (见 DIE.Server\Match\LidgrenHost.cs)。

    ## 依赖闭包

    干净得出奇: -iae\ 的 34 个文件只 using BCL 和 Lidgren.Network\ 的 3 个文件
    (NetConnectionStatus / NetException / NetMessageType), **零跨混淆命名空间引用**。

    另外 GAME 树里没有 StunMessage / StunTCP 的副本, 所以不存在 CRIB 树那种
    "全限定名相同、底层类型不同"的冲突, 可以和 Stunlock.Core 共存于同一进程。

    ## 混淆名

    类型和成员名都是混淆的 (_0023gce = NetPeer, _0023nfe = NetPeerConfiguration …)。
    不做反混淆重命名 —— 那等于手改生成代码。可读的那一层在 LidgrenHost.cs 里包装。
  -->
  <PropertyGroup>
    <RootNamespace>Lidgren.Network</RootNamespace>
    <AssemblyName>DIE.Lidgren</AssemblyName>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NoWarn>$(NoWarn);CS0108;CS0114;CS0169;CS0219;CS0414;CS0618;CS0649;CS1591;CS0162;CS0067;CS0660;CS0661;CS0693;CS3021;CS0164;SYSLIB0011;SYSLIB0003;SYSLIB0021;SYSLIB0014;CS1522;CA1416;CA2200</NoWarn>
  </PropertyGroup>

  <!--
    先过清洗脚本再编译, 理由同 DIE.GameLogic, 外加一条这里特有的:

    SmartAssembly 把 Lidgren 的类型全内部化了, 而 StunGameNetwork 的 public 成员
    直接暴露它们 (NetPeer / NetIncomingMessage 等)。跨程序集时 InternalsVisibleTo
    只解决"能不能访问", 解决不了"public 成员不能暴露非 public 类型" (CS0052),
    所以这一侧也必须一起放宽。
  -->
  <PropertyGroup>
    <LidgrenGenerated>$(MSBuildThisFileDirectory)obj\gamesrc\</LidgrenGenerated>
  </PropertyGroup>

  <Target Name="SanitizeLidgrenSources" BeforeTargets="BeforeCompile">
    <Exec Command="python &quot;$(MSBuildThisFileDirectory)..\..\tools\sanitize_decompiled.py&quot; &quot;$(GameSrc.TrimEnd('\'))&quot; &quot;$(LidgrenGenerated.TrimEnd('\'))&quot; -iae Lidgren.Network"
          StandardOutputImportance="normal" />
    <ItemGroup>
      <Compile Include="$(LidgrenGenerated)**\*.cs" LinkBase="Generated" />
      <!-- 由 _Fixups\NetBitVector.cs 取代: 索引器 setter 的参数名没还原出来 (CS0103) -->
      <Compile Remove="$(LidgrenGenerated)-iae\-hae.cs" />
    </ItemGroup>
  </Target>

  <ItemGroup>
  </ItemGroup>

</Project>
