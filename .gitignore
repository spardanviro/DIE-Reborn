# ---------------------------------------------------------------------------
# 构建产物
# ---------------------------------------------------------------------------
bin/
obj/

# obj\gamesrc\ 是清洗脚本从反编译树镜像出来的源码 (约 2500 个文件)。
# 纯生成物, 由 tools\sanitize_decompiled.py 随时重建, 不进仓库。
# 上面的 obj/ 已经覆盖它, 这里只是留个说明。

# ---------------------------------------------------------------------------
# 运行时状态
# ---------------------------------------------------------------------------
# SQLite 账号库 —— 每台机器的本地状态, 且含 Steam ID。schema 在 Data\Schema.sql 里,
# 库文件本身随时可重建。
*.db
*.db-shm
*.db-wal
logs/

# 开服机器的公网地址 —— 每台机器不一样, 也不该进仓库。格式见 MatchHostAddress.PublicHostFile。
public-host.txt

# 服务器在登陆器列表里的名字 / 位置 —— 同上, 每台机器自己填。模板在 tools\server-pack\server-info.txt。
/server-info.txt

# 离局惩罚免罚名单 —— 含 Steam ID, 每台机器自己配。格式见 LeavePunishmentStore.ExemptFile。
leave-punish-exempt.txt

# ---------------------------------------------------------------------------
# 抓包
# ---------------------------------------------------------------------------
# captures\ 里的**黄金向量**要留 (043_LoginRequest.bin 是测试的输入),
# 但一次性的运行日志不留。
captures/*.log
captures/output_log*.txt

# ---------------------------------------------------------------------------
# 编辑器 / 系统
# ---------------------------------------------------------------------------
.vs/
.idea/
*.user
*.suo
Thumbs.db
desktop.ini

# ---------------------------------------------------------------------------
# 不在这里的东西 (说明, 不是规则)
# ---------------------------------------------------------------------------
# 四棵反编译树在 DIE_Reborn 之外 (..\StunCore_SourceCode 等), 天然不进仓库。
# 这是有意的: 它们是**可再生的输入**, 由 ILSpy 从游戏的 Managed\*.dll 生成,
# 体积大 (GAME 树 3144 个文件) 且随时可重跑。项目通过 Directory.Build.props
# 里的 glob 引用它们, 从物理上杜绝"手改生成代码"。
#
# 换机器/换人接手时需要先自己反编译一遍 —— 见 PROJECT_STATUS.md 的工具链一节
# (必须用 ILSpy, 不能用 dnSpyEx, 原因在那里)。

# ---------------------------------------------------------------------------
# 不随源码分发、需要自己准备的文件 (见 README)
# ---------------------------------------------------------------------------
data/GameCraftingData.xml
lib/steamworks/steam_api64.dll
